# Public, read-only Umami report.
# Store the real link only in Vercel.
UMAMI_SHARE_URL=

# Dashboard owner credentials.
# Generate the password hash using: npm run hash-password
ADMIN_USERNAME=ali
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Optional, comma-separated IP allowlist.
# Leave empty to allow login from any IP.
TRUSTED_IPS=
