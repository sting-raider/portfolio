# Umami Cloud: https://cloud.umami.is
UMAMI_API_BASE=https://api.umami.is/v1
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=

# Dashboard owner credentials. Generate the password value with:
# npm run hash-password
ADMIN_USERNAME=ali
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Optional, comma-separated. Leave empty to allow login from any IP.
# Example: TRUSTED_IPS=203.0.113.10,2001:db8::1
TRUSTED_IPS=
